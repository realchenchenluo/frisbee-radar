@echo off
title 生成飞盘日报
cd /d "%~dp0"

echo ============================================================
echo   生成飞盘日报（采集 + 判断 + 出文档）
echo ============================================================
echo.
echo   先采集一轮，然后判断要不要出文档：
echo     - 没有新的             就结束，不出文档
echo     - 有新的但不够多       也结束，不出文档
echo     - 攒够了 / 权威号发了   生成日报
echo.
echo   日报输出位置：D:\Desktop\每日飞盘记录
echo   文件名形如：  2026-10-07_飞盘日报.docx
echo.
echo   采集时会刻意放慢请求以免被风控，请耐心等待。
echo   中途可按 Ctrl+C 中断，已采集的数据不会丢。
echo ============================================================
echo.

.venv\Scripts\python.exe run.py watch

echo.
echo ------------------------------------------------------------
echo   完成。若本次没有新内容，上面会写明原因，属正常。
echo ------------------------------------------------------------
pause
